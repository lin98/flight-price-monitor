# 複製成 .env 後依需要調整；.env 已在 .gitignore，不要把任何金鑰放進本檔案。

# 資料目錄（預設 ./data）
FARE_WATCH_DATA_DIR=data

# 票價來源：fli（預設，先問可選的 flights 套件、失敗退回瀏覽器）、
# google_playwright（真實瀏覽器，fli 的 fallback）、
# google（純 HTTP 可分享查詢頁，多半拿不到）、amadeus（需憑證，2027 幾乎無資料）
# fli 沒裝也能跑，會一路走 google_playwright；想用就 pip install flights
FARE_WATCH_SOURCE=fli
FARE_WATCH_CURRENCY=TWD

# 對 Google 的禮貌節流：每個行程之間隨機等待秒數
FARE_WATCH_DELAY_MIN=3
FARE_WATCH_DELAY_MAX=7

# --loop 模式每輪間隔（分鐘）
FARE_WATCH_INTERVAL_MINUTES=720

# 排程（scripts/run_grouped.sh）每輪抓幾格：一格＝一個出發日 × 一個機場，
# 24 格約 22 分鐘；整個視窗 184 格，一天兩輪約 4 天輪完
FARE_WATCH_MAX_FETCHES=24

# 可選：scripts/ 預設用專案的 .venv（scripts/setup.sh 建的），想換別的直譯器才設
# FARE_WATCH_PYTHON=/path/to/python3

# 可選：自訂 User-Agent（留空用內建桌面 Chrome UA）
# FARE_WATCH_USER_AGENT=

# 可選：替代來源 Amadeus Self-Service（https://developers.amadeus.com 免費 test 金鑰）
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=
# AMADEUS_HOST=test            # test（預設，抽樣資料）| production | 完整 base URL
# AMADEUS_MIN_INTERVAL=0.5     # 連續請求最短間隔秒數
# AMADEUS_MAX_ATTEMPTS=3
